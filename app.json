{
  "expo": {
    "name": "ilimiChat",
    "slug": "ilimichat",
    "scheme": "ilimichat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B5FFF"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ne.adu.ilimichat",
      "buildNumber": "1",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "ilimiChat a besoin d'accéder à vos photos pour les partager dans vos conversations.",
        "NSCameraUsageDescription": "ilimiChat a besoin de la caméra pour envoyer des photos dans vos conversations."
      }
    },
    "android": {
      "package": "ne.adu.ilimichat",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B5FFF"
      },
      "permissions": ["CAMERA", "READ_MEDIA_IMAGES", "POST_NOTIFICATIONS", "VIBRATE"]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "ilimiChat accède à vos photos pour les partager dans vos conversations.",
          "cameraPermission": "ilimiChat accède à la caméra pour envoyer des photos."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0B5FFF"
        }
      ]
    ],
    "extra": {
      "eas": { "projectId": "00000000-0000-0000-0000-000000000000" }
    }
  }
}
