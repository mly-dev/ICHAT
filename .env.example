# URL de base de l'API (back-end Ibou) — à confirmer
EXPO_PUBLIC_API_URL=https://api.ilimichat.adu.ne
# URL du serveur temps réel (socket.io) — à confirmer
EXPO_PUBLIC_SOCKET_URL=https://api.ilimichat.adu.ne
# Timeout des requêtes HTTP, en millisecondes
EXPO_PUBLIC_API_TIMEOUT=20000
# Active les mocks quand le back n'est pas disponible (1 = actif)
EXPO_PUBLIC_USE_MOCKS=1
